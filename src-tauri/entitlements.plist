<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WKWebView requires JIT for JavaScript execution -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required alongside JIT for WKWebView -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Allow Tauri's bundled dylibs without Apple signature -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Outbound network for share links, GitHub auth, auto-update -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- File watching and asset reading from ~/github/** -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
</dict>
</plist>
