{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "platter",
  "version": "0.4.0",
  "identifier": "dev.rudra.platter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "platter",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**", "/**"],
          "deny": []
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://platter.pages.dev/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNUUzMjlFODJERTI5MTcKUldRWEtkNkNuakplMFI5VUsxb1JyRjlTVFA5K2hFa3pEZHFheDVsQzJuSWF2TkhYK0NxMXhPZ20K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Review tray for assets generated by Claude Code agents",
    "longDescription": "Platter watches the folders where Claude Code (and other AI agents) drop mockups, screenshots, and PDFs — and surfaces them in a Pinterest-style gallery. It exposes an MCP server so Claude can pause for a human review before continuing.",
    "copyright": "© 2026 Rudra Pratap Singh",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null,
      "dmg": {
        "background": null,
        "windowSize": { "width": 660, "height": 400 },
        "windowPosition": { "x": 200, "y": 200 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  }
}
