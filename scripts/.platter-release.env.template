# Platter — release-time secrets
#
# Copy this file to ~/.platter-release.env (gitignored) and fill in the values.
# Used by scripts/release.sh --signed for local signed-release builds.
#
# These same values must also be set as GitHub repo secrets so CI can sign.
# Run scripts/setup-secrets.sh to print the values you should paste into the
# GitHub Secrets UI.

# ─── Tauri auto-updater signing ───────────────────────────────────────────
# These come from the keypair generated locally with:
#   npx @tauri-apps/cli signer generate -w ~/.tauri/platter-updater.key
# Lose the key and every existing user is stranded — back it up.
export TAURI_SIGNING_PRIVATE_KEY="$(cat ~/.tauri/platter-updater.key)"
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD="$(cat ~/.tauri/platter-updater.password)"

# ─── Apple Developer ID (the same cert you use for Slipstream/Penova) ─────
# Discover the identity:
#   security find-identity -v -p codesigning
export APPLE_SIGNING_IDENTITY="Developer ID Application: Rudra Pratap Singh (TEAMID)"

# Your Apple ID email
export APPLE_ID="rudra.ptp.singh@gmail.com"

# Generate at https://appleid.apple.com → Sign-In & Security → App-Specific Passwords
# Format: xxxx-xxxx-xxxx-xxxx
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# 10-char Team ID from https://developer.apple.com/account
export APPLE_TEAM_ID="ABCDE12345"
